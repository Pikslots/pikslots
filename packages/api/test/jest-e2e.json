{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-test.ts$",
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "node",
          "resolvePackageJsonExports": false,
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*(kysely|uuid|@nestjs/schedule))"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "reporters": [
    "default",
    [
      "jest-html-reporters",
      {
        "publicPath": "./test-report/e2e",
        "filename": "index.html",
        "pageTitle": "API E2E Test Report",
        "openReport": false
      }
    ]
  ]
}
