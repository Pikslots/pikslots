<html lang='en'>
  <head>
    <meta name='viewport' content='width=device-width' />
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <title>Your booking is confirmed</title>
    <link
      href='https://fonts.googleapis.com/css2?family=Fira+Code:wght@600&family=Roboto:wght@400;500&display=swap'
      rel='stylesheet'
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: #f5f0f5;
        font-family:
          'Roboto',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        font-size: 14px;
        line-height: 1.6;
        color: #1a1523;
        -webkit-font-smoothing: antialiased;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
        background-color: #f5f0f5;
      }

      .container {
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e8e0e8;
      }

      .header {
        padding: 32px 40px 28px;
        border-bottom: 1px solid #e8e0e8;
      }

      .logo {
        font-family: 'Fira Code', 'Roboto', monospace;
        font-size: 18px;
        font-weight: 600;
        color: #1a1523;
        letter-spacing: -0.02em;
        text-decoration: none;
      }

      .logo span {
        color: #4f46e5;
      }

      .body {
        padding: 40px 40px 44px;
      }

      .greeting {
        font-size: 22px;
        font-weight: 600;
        color: #1a1523;
        letter-spacing: -0.02em;
        margin-bottom: 12px;
      }

      .intro {
        color: #6b6075;
        font-size: 14px;
        margin-bottom: 28px;
        line-height: 1.7;
      }

      .booking-ref {
        display: inline-block;
        background-color: #eef2ff;
        border: 1px solid #c7d2fe;
        padding: 8px 16px;
        font-family: 'Fira Code', monospace;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: #4f46e5;
        margin-bottom: 28px;
      }

      .details {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 12px;
      }

      .details tr {
        border-bottom: 1px solid #e8e0e8;
      }

      .details tr:last-child {
        border-bottom: none;
      }

      .details th {
        text-align: left;
        font-weight: 500;
        color: #6b6075;
        font-size: 13px;
        padding: 12px 0;
        width: 40%;
        vertical-align: top;
      }

      .details td {
        text-align: right;
        color: #1a1523;
        font-size: 14px;
        font-weight: 500;
        padding: 12px 0;
        vertical-align: top;
      }

      .note {
        font-size: 12px;
        color: #6b6075;
        margin-top: 20px;
        line-height: 1.7;
      }

      .footer {
        padding: 20px 40px 28px;
        border-top: 1px solid #e8e0e8;
      }

      .footer-text {
        font-size: 12px;
        color: #6b6075;
        line-height: 1.6;
      }

      @media only screen and (max-width: 560px) {
        .header,
        .body,
        .footer {
          padding-left: 24px;
          padding-right: 24px;
        }
        .greeting {
          font-size: 18px;
        }
        .details th,
        .details td {
          display: block;
          width: 100%;
          text-align: left;
        }
        .details th {
          padding-bottom: 2px;
        }
        .details td {
          padding-top: 2px;
        }
      }
    </style>
  </head>

  <body>
    <div class='wrapper'>
      <div class='container'>

        <div class='header'>
          <span class='logo'>Pikslots</span>
        </div>

        <div class='body'>
          <p class='greeting'>Hi {{firstName}},</p>
          {{#if isTeamMember}}
            <p class='intro'>
              <strong>{{guestFullName}}</strong>
              has booked <strong>{{serviceName}}</strong> with you at
              <strong>{{businessName}}</strong>. The booking is confirmed —
              details below.
            </p>
          {{else}}
            <p class='intro'>
              Your booking at
              <strong>{{businessName}}</strong>
              is confirmed. See the details below.
            </p>
          {{/if}}

          <div class='booking-ref'>{{bookingRef}}</div>

          <table class='details'>
            <tr>
              <th>Service</th>
              <td>{{serviceName}}</td>
            </tr>
            <tr>
              <th>Date</th>
              <td>{{bookingDate}}</td>
            </tr>
            <tr>
              <th>Time</th>
              <td>{{startTime}} &ndash; {{endTime}}</td>
            </tr>
            <tr>
              <th>Team member</th>
              <td>{{teamMemberName}}</td>
            </tr>
            <tr>
              <th>Business</th>
              <td>{{businessName}}</td>
            </tr>
            <tr>
              <th>Price</th>
              <td>{{price}} {{currency}}</td>
            </tr>
          </table>

          <p class='note'>
            Please arrive a few minutes early. If you need to reschedule or
            cancel, contact {{businessName}} directly.
          </p>
        </div>

        <div class='footer'>
          <p class='footer-text'>
            © 2026 Pikslots. All rights reserved.<br />
            This confirmation was sent because a booking was made with your
            email address.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>
